## uv ##
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# BEGIN rn-forge kiln
# kiln's own state
.rn-forge/kiln/backups/
.rn-forge/kiln/rendered/
.rn-forge/kiln/state.lock

# macOS
.DS_Store

# Scratch root (tests and tools write here; task clean removes it)
.tmp/

# Python tool caches
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.uv-cache/

# Coverage output
.coverage
.coverage.*
coverage.xml

# Docs build output ([docs] site_dir)
.docs-site/
# END rn-forge kiln

# generated shell API reference (mise run docs)
docs/reference/shell/
.sonar-cleanup/

# BEGIN rn-forge agentkit
.rn-forge/agentkit/*/rendered/
.rn-forge/agentkit/*/hooks/
.rn-forge/agentkit/_common/
.rn-forge/agentkit/state.json
.rn-forge/agentkit/backups/
# END rn-forge agentkit

# local settings
.claude/settings.local.json
